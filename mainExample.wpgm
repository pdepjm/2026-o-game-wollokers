import wollok.game.*
import globos.*
import puntero.*
import monos.*
import flechas.*
import vidas.*
import rondas.*
import dinero.*

program BloonsWLK {

	game.title("Bloons WLK")
	game.height(70)
	game.width(140)
	game.boardGround("mapa1.png")
	game.cellSize(10)
	
	const monos = []
	
	game.addVisual(contadorDeVidas)
	game.addVisual(dinero)
	armarFlechas.armarMapa1()
	game.addVisualCharacter(puntero)

	keyboard.space().onPressDo({
		const posicion = puntero.position()
		console.println(posicion)
	})

	keyboard.r().onPressDo({

		const monoNuevo = new MonoRapido()
		if (dinero.puedePagar(monoNuevo.costo())) {
			dinero.pagar(monoNuevo.costo())
			monoNuevo.position(puntero.position())
			monos.add(monoNuevo)
			game.addVisual(monoNuevo)
			monoNuevo.iniciarAtaque()
		}
	})

	keyboard.l().onPressDo({

		const monoNuevo = new MonoLejano()
		if (dinero.puedePagar(monoNuevo.costo())) {
			dinero.pagar(monoNuevo.costo())
			monoNuevo.position(puntero.position())
			monos.add(monoNuevo)
			game.addVisual(monoNuevo)
			monoNuevo.iniciarAtaque()
		}
	})

	entreTiempo.espera()

	game.start()
}