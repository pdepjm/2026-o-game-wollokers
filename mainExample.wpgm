import wollok.game.*
import globos.*
import puntero.*
import monos.*
import flechas.*
import vidas.*
import rondas.*
import dinero.*

program BloonsWLK {
	game.title("Bloons WLK")
	game.height(70)
	game.width(140)
	game.boardGround("mapa1.png")
	game.cellSize(10)
	
	const monos = []
	
	game.addVisual(contadorDeVidas)
	game.addVisual(dinero)
	armarFlechas.armarMapa1()
	game.addVisualCharacter(puntero)


	//SOLO PARA PROBAR: con la tecla P se pincha el primer globo. Cuando los monos puedan atacar, se borra esto
	keyboard.p().onPressDo({
		if (not gestorDeGlobos.activos().isEmpty()) {  
			gestorDeGlobos.activos().first().pinchar() 
		}
	})
	
	keyboard.space().onPressDo({
		const posicion = puntero.position()
		console.println(posicion)}) //con esto tocan espacio y ven en la terminal en que casilla estan asi pueden poner bien las cosas :)

	
	
	
	
	/* const monoNuevo = new Mono(numero =1, costo = 300, disparoVel = 2000)
	monos.add(monoNuevo)
	game.addVisual(monoNuevo)*/

	/*monos.forEach({mono => game.onTick(mono.getDisparoVel(), "romperGlobo",{mono.atacar(globos)})})*/


	entreTiempo.espera()

	
	
	



		
	game.start()
}
