import wollok.game.*

import example.cursor
import example.Mono
import example.Globo

program PepitaGame {
	game.title("Bloons WLK")
	game.height(10)
	game.width(20)
	game.boardGround("mapa1.png")

	game.addVisualCharacter(cursor)

	keyboard.up().onPressDo({ cursor.subir()})
	keyboard.down().onPressDo({ cursor.bajar()})
	keyboard.left().onPressDo({ cursor.izquierda()})
	keyboard.right().onPressDo({ cursor.derecha()})

	keyboard.space().onPressDo({ 
		const monoEnCursor = new Mono(numero = 1, costo = 300, disparoVel = 1, position = cursor.position())
		game.addVisual(monoEnCursor)
	})
	
	const monoNuevo = new Mono(numero =1, costo = 300, disparoVel = 1)
	game.addVisual(monoNuevo)
	
	const globos = []

	game.onTick(2000, "generar" ,{
		const globoNuevo = new Globo(numero = 1, velocidad = 1)
		globos.add(globoNuevo)
		game.addVisual(globoNuevo)
		})

	game.onTick(7000, "generar2" ,{
		const globoNuevo = new Globo(numero = 2, velocidad = 2 )
		globos.add(globoNuevo)
		game.addVisual(globoNuevo)
		})
	
	game.onTick(1000, "moverGlobos", {globos.forEach{ globo => globo.avanzar() }})

	game.onTick(500, "BorrarGlobos", {
        const globosQueSalieron = globos.filter({ globo => globo.position().x() >= 20 })
        globosQueSalieron.forEach({ globo =>  game.removeVisual(globo) globos.remove(globo)}) })

	game.onTick(3000, "MOVER_Y_LIMPIAR", {
    // Acá va tu lógica de mover y eliminar si salen del mapa...
    
    // Imprime la cantidad actual de globos vivos
    console.println("Cantidad de globos en lista: " + globos.size())
    
    // Si querés ver las referencias exactas de los objetos:
    console.println(globos) 
})

	game.start()
}
