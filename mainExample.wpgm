import wollok.game.*
import puntero.*
import protectores.*
import flechas.*
import vidas.*
import rondas.*
import dinero.*
import pantallaInicio.*

program NightmareHunt {
    game.title("Nightmare Hunt")
    game.height(10)
    game.width(17)
    game.boardGround("mapa1.png")
    game.cellSize(64)
    game.addVisual(contadorDeVidas)
    game.addVisual(dinero)
    armarFlechas.armarMapa1()
    game.addVisual(puntero)
    game.addVisual(pantallaInicio)



    keyboard.enter().onPressDo({
        game.removeVisual(pantallaInicio)
        keyboard.enter().clean()
    })
    keyboard.up().whilePressedDo({
        puntero.position(
            puntero.position().up(1)
        )
    }, 100)
    keyboard.down().whilePressedDo({
        puntero.position(
            puntero.position().down(1)
        )
    }, 100)
    keyboard.left().whilePressedDo({
        puntero.position(
            puntero.position().left(1)
        )
    }, 100)
    keyboard.right().whilePressedDo({
        puntero.position(
            puntero.position().right(1)
        )
    }, 100)



    keyboard.1().onPressDo({

        gestorDeProtectores.colocar(

            new Oveja(),

            puntero.position()
        )
    })
    keyboard.2().onPressDo({

        gestorDeProtectores.colocar(

            new PerroGuardian(),

            puntero.position()
        )
    })
    keyboard.3().onPressDo({

        gestorDeProtectores.colocar(

            new LamparaProtectora(),

            puntero.position()
        )
    })
    keyboard.4().onPressDo({

        gestorDeProtectores.colocar(

            new PastorDeSuenos(),

            puntero.position()
        )
    })
    keyboard.v().onPressDo({

        gestorDeProtectores.venderEn(

            puntero.position()
        )
    })



    entreTiempo.espera()
    console.println("Controles:")
    console.println("1: colocar oveja")
    console.println("2: colocar perro guardian")
    console.println("3: colocar lampara protectora")
    console.println("4: colocar pastor de sueños")
    console.println("V: vender protector")
    console.println("E: comenzar siguiente ronda")
    console.println("ENTER: cerrar pantalla de inicio")
    game.start()
}